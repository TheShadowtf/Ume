<?xml version="1.0" encoding="utf-8"?>
<Project>
  <ItemGroup>
    <!-- Auto-generated by UmeEditor to keep old-style script projects in sync with Source/*.cs files -->
    <Compile Include="**\*.cs" Exclude="@(Compile);Binaries\**\*;Intermediates\**\*;bin\**\*;obj\**\*" />
  </ItemGroup>
  <ItemGroup>
    <!-- Auto-generated by UmeEditor to avoid rebuilding ScriptCore during game script compile -->
    <ProjectReference Remove="**\Ume-ScriptCore.csproj" />
    <Reference Include="Ume-ScriptCore">
      <HintPath>$(MSBuildThisFileDirectory)Binaries\Ume-ScriptCore.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
